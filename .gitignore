# ─────────────────────────────────────────────────────────
# valuarty — root .gitignore
# ─────────────────────────────────────────────────────────

# Data export (61MB, transferimos vía docker cp, no via git)
data_export/
data_export/**

# Secrets — NO commitear NUNCA
**/secrets.env
**/*.secret
**/.env
**/.env.local
**/.env.production
!**/.env.example

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
*.egg
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.tox/

# Virtual environments
.venv/
venv/
ENV/
env/

# Node / Next.js
node_modules/
.next/
out/
dist/
build/
.turbo/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Docker — override.yml es local-only (port mappings de testing).
# NO subir a GitHub: Docker Compose auto-merge podría aplicarlo en prod
# si Coolify decidiera leerlo. Mantenelo local con tu copia.
**/docker-compose.override.yml

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db
desktop.ini

# Logs
*.log
logs/

# Local databases / backups
*.db
*.sqlite
*.sqlite3
*.dump
*.sql.gz

# Backups
*.backup
*.bak

# Python build/cache files inside argfy
argfy/backend/data/
argfy/backend/__pycache__/
argfy/backend/**/__pycache__/

# Frontend build artifacts
argfy/frontend/.next/
argfy/frontend/node_modules/
argfy/frontend/.vercel/

