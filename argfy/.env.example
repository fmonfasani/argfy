# --- Postgres (docker-compose) ---
POSTGRES_DB=argfy
POSTGRES_USER=argfy
POSTGRES_PASSWORD=argfy_dev
POSTGRES_PORT=5544

# --- Backend app ---
# Sqlite legacy (default si no se setea):
#   DATABASE_URL=sqlite:///./data/argentina.db
# Postgres (dev local via docker-compose):
DATABASE_URL=postgresql+psycopg2://argfy:argfy_dev@localhost:5544/argfy

ENVIRONMENT=development
DEBUG=true
