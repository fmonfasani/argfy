# Backend .env — copy to .env and fill secrets. NEVER commit .env.
# Defaults aquí son seguros para dev. Cambiar todo lo marcado CHANGE-IN-PROD.

# --- Database ---
# SQLite (default, dev rápido):
DATABASE_URL=sqlite:///./data/argentina.db
# Postgres (dev local via docker-compose):
# DATABASE_URL=postgresql+psycopg2://argfy:argfy_dev@localhost:5544/argfy

# --- Environment ---
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO
LOG_EMOJIS=false

# --- Security (CHANGE-IN-PROD) ---
SECRET_KEY=dev-secret-key-change-in-production-please
JWT_SECRET=dev-jwt-secret-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRY_HOURS=72

# --- CORS ---
# JSON array; pydantic parsea con env_nested_delimiter no aplicado aquí
# CORS_ORIGINS=["https://argfy.com","https://www.argfy.com"]

# --- Google OAuth (CHANGE-IN-PROD) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Mercado Pago (CHANGE-IN-PROD) ---
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
MP_SUCCESS_URL=http://localhost:3000/account/billing
MP_FAILURE_URL=http://localhost:3000/pricing
MP_PENDING_URL=http://localhost:3000/account/billing

# --- External APIs ---
BCRA_API_URL=https://api.bcra.gob.ar

# --- Cache / Redis ---
# Vacío deshabilita el cache. En prod: redis://redis:6379/0
REDIS_URL=
CACHE_TTL=300

# --- Rate Limiting ---
RATE_LIMIT_PER_MINUTE=60

# --- Scheduler / ETL ---
ENABLE_SCHEDULER=true
DATA_REFRESH_INTERVAL=900
UPDATE_INTERVAL_MINUTES=15
DEMO_MODE=false

# --- Monitoring ---
ENABLE_MONITORING=true
# Vacío deshabilita Sentry; en prod: https://<key>@sentry.io/<project>
SENTRY_DSN=
